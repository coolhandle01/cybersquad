# Mutation testing (mutmut): throwaway per-run artefacts, never committed. The
# audit recipe writes a temporary [mutmut] setup.cfg and copies a mutants/ tree
# beside the source; the repo itself keeps all real config in pyproject.toml, so
# there is no genuine setup.cfg to shadow here.
mutants/
setup.cfg

# IDE
.idea/
# .vscode: share the project-level configs, ignore personal overrides
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Claude Code personal overrides (committed: .claude/settings.json)
.claude/settings.local.json

