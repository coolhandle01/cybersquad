/* cybersquad's theme layer, loaded after crewui's default.tcss (see
   tools/tui/__init__.py's CSS_PATH). crewui ships the structural CSS; this
   file carries only cybersquad's visual preferences and wins on ties. Keep it
   to look-and-feel - structure and behaviour stay in crewui. */

/* Slimmer scrollbars: half Textual's default vertical width (2 -> 1), so the
   bar reads as a hairline rather than a slab, in every scrollable pane. */
#agent-session, #crew-log, #sidebar {
    scrollbar-size-vertical: 1;
}

/* Breathing room between the turn boxes and the scrollbar. The gap goes on the
   *boxes* (margin), not the scroll container (padding): container padding drags
   the scrollbar inward with the content - misaligning it from the log pane's
   bar and leaving no visible gap - whereas box margin shrinks the box alone, so
   the bar stays at the pane edge, aligned, with clear air to its left.
   Measured in tests/test_tui.py. */
.agent-turn, .you-box, .gate-box, .finish-rule {
    margin-right: 1;
}
